# Copiar a .env y ajustar rutas locales.
# Fuente principal del proyecto (PEF avance de gasto 2026)
PEF_RAW_CSV=C:\Users\fulio\Downloads\PEF_avance_gasto.csv

# Rutas relativas al directorio raíz del proyecto
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
WAREHOUSE_DB=warehouse/warehouse.duckdb

# API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Modelos ML serializados (se generan en fases posteriores)
ML_REGRESSION_MODEL=ml/artifacts/regression_model.joblib
ML_CLASSIFICATION_MODEL=ml/artifacts/classification_model.joblib
ML_PREPROCESSOR=ml/artifacts/preprocessor.joblib

# Frontend (Vite) — URL base de la API para el cliente
VITE_API_BASE_URL=http://127.0.0.1:8000
